foreign class CColor {
  foreign construct new()
  foreign construct new(r, g, b, a)

  foreign r
  foreign g
  foreign b
  foreign a

  foreign static Black
  foreign static White
  foreign static Red
  foreign static Green
  foreign static Blue

  foreign static packColor(color)
  foreign static packRGBA(color)
  foreign static packARGB(color)
  foreign static packABGR(color)
}
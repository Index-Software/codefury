#include "../Constants.cginc"

float4 main(
    float2 ndc : TEXCOORD0,

    uniform sampler2D EnvironmentMap,
    uniform float4 g_CameraRight,
    uniform float4 g_CameraUp,
    uniform float4 g_CameraForward,
    uniform float g_TanHalfFOV,
    uniform float g_AspectRatio) : COLOR
{
    float3 rayDir = normalize(
        g_CameraForward.xyz +
        g_CameraRight.xyz * ndc.x * g_TanHalfFOV * g_AspectRatio +
        g_CameraUp.xyz * ndc.y * g_TanHalfFOV);

    float u = 0.5 + atan2(rayDir.z, rayDir.x) / CF_TWO_PI;
    float v = 0.5 - asin(rayDir.y) / CF_PI;

    return tex2D(EnvironmentMap, float2(u, v));
}
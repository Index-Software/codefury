#ifndef LIT_PASS_ADD
#define LIT_PASS_BASE
#endif // !LIT_PASS_ADD

#include "../Lit.cginc"
#include "../Bindings.cginc"
#include "../Model.cginc"
#include "../Camera.cginc"
#include "../Scene.cginc"

struct FragmentInput_t
{
    float3 worldPos : TEXCOORD0;
    float3 normal : TEXCOORD1;
    float3 color : TEXCOORD2;
#ifndef LIT_PASS_ADD
    float4 shadowPos : TEXCOORD3;
#endif // !LIT_PASS_ADD
    float4 position : WPOS;
};

struct FragmentOutput_t
{
    float4 color : COLOR;
};

FragmentOutput_t main(
    FragmentInput_t input,
    uniform float Smoothness,
    uniform float Metallic)
{
    FragmentOutput_t output;

    float3 normal = normalize(input.normal);
#ifdef LIT_PASS_ADD
    float4 shadowPos = float4(0.0, 0.0, 0.0, 0.0);
#else // LIT_PASS_ADD
    float4 shadowPos = input.shadowPos;
#endif // !LIT_PASS_ADD
    float3 viewDir = normalize(g_CameraPos.xyz - input.worldPos);

    float smoothness = clamp(Smoothness, 0.0, 1.0);
    if (Smoothness == 0.0 && Metallic == 0.0)
    {
        smoothness = 0.5;
    }

    float3 albedo_srgb = input.color;
    float3 finalColor = GetStandardLighting(
        input.worldPos,
        shadowPos,
        normal,
        viewDir,
        smoothness,
        Metallic,
        albedo_srgb,
        input.position.xy);

    finalColor = LinearToSRGB(finalColor);

    output.color = float4(finalColor, 1.0);

    return output;
}
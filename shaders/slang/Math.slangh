#ifndef MATH_SLANGH
#define MATH_SLANGH

float3 SRGBToLinear(float3 color)
{
    return pow(color, 2.2);
}

float3 LinearToSRGB(float3 color)
{
    return pow(color, 1.0 / 2.2);
}

float Median3(float a, float b, float c)
{
    return max(min(a, b), min(max(a, b), c));
}

#endif // MATH_SLANGH
#ifndef CAMERA_SLANGH
#define CAMERA_SLANGH

#include "Bindings.slangh"

[vk::binding(11, 0)] cbuffer Camera
{
    float4 g_CameraPos;
    float4 g_CameraRight;
    float4 g_CameraUp;
    float4 g_CameraForward;
    float g_TanHalfFOV;
    float g_AspectRatio;
};

